diff --git a/app/Services/TeacherDirectory.php b/app/Services/TeacherDirectory.php
new file mode 100644
--- /dev/null
+++ b/app/Services/TeacherDirectory.php
@@ -0,0 +1,59 @@
+<?php
+
+namespace App\Services;
+
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+
+// Shared content contract: keep this class and the fallback resource in both projects.
+class TeacherDirectory
+{
+    public static function defaults(): array
+    {
+        return (require resource_path('content/staff-directory.php')) + [
+            'directory_eyebrow' => 'KENALI KELUARGA SEKOLAH KAMI',
+            'directory_title' => "Wajah ramah,\nteman tumbuh anak.",
+            'directory_description' => 'Di kelas, di perpustakaan, hingga di gerbang sekolah—ada tim yang siap mendampingi langkah kecil buah hati Anda.',
+            'demo_profiles' => true,
+        ];
+    }
+
+    public static function withDefaults(array $saved): array
+    {
+        $data = $saved + self::defaults();
+        $data['people'] = array_map(fn (array $person) => $person + ['photo'=>null], $data['people']);
+        return $data;
+    }
+
+    public static function validate(array $data): void
+    {
+        $indices = array_keys($data['people'] ?? []);
+        Validator::make($data, [
+            'people' => ['required', 'array', 'list', 'min:1', 'max:100'],
+            'people.*.name' => 'required|string|max:150',
+            'people.*.role' => 'required|string|max:150',
+            'people.*.description' => 'required|string|max:2000',
+            'people.*.group' => ['required', Rule::in(['pimpinan', 'guru', 'staf'])],
+            'people.*.portrait' => 'required|integer|min:0|max:29',
+            'people.*.photo' => ['nullable', 'string', 'regex:#^/(?:assets/(?:design|team)|media)/[a-zA-Z0-9_-]+\.(?:png|jpe?g|webp)$#'],
+            'subjects' => 'present|array|list|max:100',
+            'subjects.*.title' => 'required|string|max:150',
+            'subjects.*.by' => 'required|string|max:300',
+            'subjects.*.text' => 'required|string|max:2000',
+            'structure.head' => ['required', 'integer', Rule::in($indices)],
+            'structure.branches' => 'present|array|list|max:30',
+            'structure.branches.*.title' => 'required|string|max:150',
+            'structure.branches.*.summary' => 'required|string|max:2000',
+            'structure.branches.*.tone' => ['required', Rule::in(['blue', 'green', 'yellow'])],
+            'structure.branches.*.lead' => ['required', 'integer', Rule::in($indices)],
+            'structure.branches.*.teams' => 'present|array|list|max:100',
+            'structure.branches.*.teams.*.title' => 'required|string|max:150',
+            'structure.branches.*.teams.*.members' => 'present|array|list|max:100',
+            'structure.branches.*.teams.*.members.*' => ['required', 'integer', Rule::in($indices)],
+            'directory_eyebrow' => 'required|string|max:150',
+            'directory_title' => 'required|string|max:300',
+            'directory_description' => 'required|string|max:2000',
+            'demo_profiles' => 'required|boolean',
+        ], ['in' => 'Pilihan :attribute tidak tersedia. Pilih anggota atau kategori yang ada.'])->validate();
+    }
+}
diff --git a/tests/Feature/SharedTeacherContentTest.php b/tests/Feature/SharedTeacherContentTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/SharedTeacherContentTest.php
@@ -0,0 +1,54 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Services\SchoolContent;
+use App\Services\TeacherDirectory;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Http;
+use Tests\TestCase;
+
+class SharedTeacherContentTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_directory_and_hero_read_the_shared_content_instead_of_local_profiles(): void
+    {
+        Http::preventStrayRequests();
+        $content = app(SchoolContent::class);
+        $teachers = $content->defaults()['teachers'] + TeacherDirectory::defaults();
+        $teachers['people'][1]['name'] = 'KEPALA DARI DASHBOARD';
+        $teachers['people'][1]['photo'] = '/media/kepala-baru.jpg';
+        $teachers['structure']['head'] = 1;
+        $teachers['directory_title'] = '<script>Judul dari dashboard</script>';
+        $teachers['subjects'][0]['by'] = 'Tim baru dari dashboard';
+        $teachers['demo_profiles'] = false;
+        $content->save('teachers',$teachers);
+        $this->get('/guru-staf')->assertOk()->assertSee('KEPALA DARI DASHBOARD')
+            ->assertSee('/media/kepala-baru.jpg',false)->assertSee('Tim baru dari dashboard')
+            ->assertSee('&lt;script&gt;Judul dari dashboard&lt;/script&gt;',false)
+            ->assertDontSee('<script>Judul dari dashboard</script>',false)
+            ->assertDontSee('Contoh profil sekolah.');
+    }
+
+    public function test_short_and_empty_published_lists_do_not_restore_default_cards(): void
+    {
+        Http::preventStrayRequests();
+        $content = app(SchoolContent::class);
+        $content->save('teachers',['team'=>[['name'=>'Satu anggota','role'=>'Guru','photo'=>'/media/guru.jpg']]]);
+        $content->save('gallery',['news'=>[]]);
+        $site = $content->all();
+        $this->assertCount(1,$site['teachers']['team']);
+        $this->assertCount(30,$site['teachers']['people']);
+        $this->assertSame([],$site['gallery']['news']);
+        $this->get('/')->assertOk();
+        $this->get('/galeri')->assertOk();
+    }
+
+    public function test_first_hero_slide_uses_the_campus_photo_from_the_dashboard(): void
+    {
+        Http::preventStrayRequests();
+        app(SchoolContent::class)->save('home',['campus_image'=>'/media/kampus-baru.jpg']);
+        $this->get('/')->assertOk()->assertSee('src="/media/kampus-baru.jpg"',false);
+    }
+}
